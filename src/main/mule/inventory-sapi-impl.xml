<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
          http://www.mulesoft.org/schema/mule/core https://www.mulesoft.org/schema/mule/core/current/mule.xsd
          http://www.mulesoft.org/schema/mule/http https://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
          http://www.mulesoft.org/schema/mule/ee/core https://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <flow name="post-inventory-reserve-flow">
        <http:listener config-ref="HTTP_Listener_Config" path="/api/v3/inventory/reserve" allowedMethods="POST"/>

        <set-variable variableName="correlationId"
            value="#[attributes.headers.'X-Correlation-ID' default uuid()]"
            doc:name="Set Correlation ID"/>

        <logger message="#['[' ++ vars.correlationId ++ '] Inventory reservation - warehouse=' ++ payload.warehouseId ++ ' items=' ++ sizeOf(payload.items)]" level="INFO" category="com.company.inventory-sapi"/>

        <choice doc:name="Validate Request">
            <when expression="#[payload.items == null or isEmpty(payload.items)]">
                <raise-error type="APP:INVALID_REQUEST" description="items array is required"/>
            </when>
            <when expression="#[payload.warehouseId == null]">
                <raise-error type="APP:INVALID_REQUEST" description="warehouseId is required"/>
            </when>
        </choice>

        <ee:transform doc:name="Build Reservation Response">
            <ee:message>
                <ee:set-payload><![CDATA[
                    %dw 2.0
                    output application/json
                    var reservationId = "RES-" ++ (randomInt(999999) as String)
                    ---
                    {
                        reservationId: reservationId,
                        warehouseId: payload.warehouseId,
                        reservationStatus: "CONFIRMED",
                        reservationTtlMinutes: payload.reservationTtlMinutes default 30,
                        estimatedDispatchDate: (now() + |P2D|) as Date as String,
                        confirmedItems: payload.items map {
                            skuCode: $.skuCode,
                            requestedQty: $.requestedQty,
                            reservedQty: $.requestedQty
                        },
                        requestMetadata: payload.requestMetadata
                    }
                ]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus">200</ee:set-variable>
            </ee:variables>
        </ee:transform>

        <error-handler>
            <on-error-propagate type="APP:INVALID_REQUEST">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[
                            %dw 2.0 output application/json
                            --- { errorCode: "INVALID_RESERVATION_REQUEST", correlationId: vars.correlationId, message: error.description }
                        ]]></ee:set-payload>
                    </ee:message>
                    <ee:variables><ee:set-variable variableName="httpStatus">400</ee:set-variable></ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="ANY">
                <logger message="#['[' ++ vars.correlationId ++ '] ERROR: ' ++ error.description]" level="ERROR" category="com.company.inventory-sapi"/>
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[
                            %dw 2.0 output application/json
                            --- { errorCode: "INTERNAL_ERROR", correlationId: vars.correlationId, message: "Internal error processing reservation" }
                        ]]></ee:set-payload>
                    </ee:message>
                    <ee:variables><ee:set-variable variableName="httpStatus">500</ee:set-variable></ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <flow name="get-health-flow">
        <http:listener config-ref="HTTP_Listener_Config" path="/api/v3/health" allowedMethods="GET"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0 output application/json --- { status: "UP", version: "3.1.0", sapConnection: "ACTIVE" }]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

</mule>